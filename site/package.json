{
  "name": "dev-digest-toolkit-site",
  "private": true,
  "type": "module",
  "description": "Static catalog site for the dev-digest-toolkit marketplace, deployed to GitHub Pages.",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "catalog:demo": "node scripts/build-catalog.mjs --root test/fixtures/marketplace --repo MShcherbyna/dev-digest-toolkit-marketplace",
    "dev": "npm run catalog && vite",
    "dev:demo": "npm run catalog:demo && vite",
    "build": "npm run catalog && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/test/*.test.mjs && vitest run",
    "e2e": "npm run catalog:demo && vite build --outDir dist-e2e && playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "minisearch": "7.2.0",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "marked": "18.1.1",
    "sanitize-html": "2.18.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
